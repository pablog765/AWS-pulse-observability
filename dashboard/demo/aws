if (svc, op) == ("cloudwatch", "get-metric-data"):
    qs = json.loads(arg("--metric-data-queries"))
    start = dt.datetime.fromisoformat(arg("--start-time").replace("Z", "+00:00"))
    res = []
    random.seed(7)
    for q in qs:
        ms = q["MetricStat"]; name = ms["Metric"]["MetricName"]; per = ms["Period"]
        n = min(int((now - start).total_seconds() // per), 400)
        ts = [now - dt.timedelta(seconds=per * i) for i in range(n)]
        if name == "FreeStorageSpace":  # ~3.5 % de crecimiento mensual del espacio usado, sobre 200 GB asignados
            reader = any("reader" in d["Value"] for d in ms["Metric"]["Dimensions"])
            t0 = dt.datetime(now.year, 4, 1, tzinfo=dt.timezone.utc)
            used = lambda t: (96 if reader else 98) * 1.035 ** ((t - t0).days / 30.44) + random.uniform(-0.4, 0.4)
            res.append({"Id": q["Id"], "Timestamps": [iso(t) for t in ts], "Values": [(200 - used(t)) * 1024 ** 3 for t in ts]})
            continue
        base = {"CPUUtilization": 72, "FreeableMemory": 3.1 * 1024 ** 3, "DatabaseConnections": 140, "AuroraReplicaLag": 25, "ReplicaLag": 0.4,
                "AllowedRequests": 160000, "BlockedRequests": 0, "CountedRequests": 22000}.get(name, 50)
        if ms["Metric"]["Namespace"] == "AWS/WAFV2" and any(d["Name"] == "RuleGroup" or (d["Name"] == "Rule" and d["Value"] != "ALL") for d in ms["Metric"]["Dimensions"]):
            rule = [d["Value"] for d in ms["Metric"]["Dimensions"] if d["Name"] == "Rule"][0]
            base = {"SizeRestrictions_BODY": 21800, "AWSManagedIPReputationList": 136, "ExploitablePaths_URIPATH": 24,
                    "SQLi_BODY": 21, "UserAgent_BadBots_HEADER": 19, "NoUserAgent_HEADER": 9}.get(rule, 1)
        vals = [max(0, base * (1 + 0.25 * random.uniform(-1, 1)) + (20 if name == "CPUUtilization" and i < 30 else 0)) for i in range(n)]
        res.append({"Id": q["Id"], "Timestamps": [iso(t) for t in ts], "Values": vals})
    out({"MetricDataResults": res})

